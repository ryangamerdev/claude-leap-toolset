[
 {
  "name": "session_open",
  "arguments": {
   "project": "/Users/ryan/src/leap-mcp/.leap/tmp/harness-project",
   "app": "Gameday"
  }
 },
 {
  "name": "@capture",
  "arguments": {
   "pattern": "\"session_id\":\"([A-F0-9-]+)\"",
   "var": "sid"
  }
 },
 {
  "name": "ui_perform",
  "arguments": {
   "session_id": "$sid",
   "steps": [
    {
     "type": "action",
     "action": "click",
     "selector": {
      "label": "Playbook",
      "role": "AXButton"
     },
     "expect": {
      "selector": {
       "label": "Edit play"
      },
      "condition": "enabled"
     },
     "timeout": 8
    },
    {
     "type": "action",
     "action": "click",
     "selector": {
      "label": "Edit play",
      "role": "AXButton"
     },
     "expect": {
      "selector": {
       "role": "AXTextArea"
      },
      "condition": "exists"
     },
     "timeout": 8
    },
    {
     "type": "observe",
     "selector": {
      "label": "Cancel"
     },
     "fields": [
      "index",
      "id",
      "enabled"
     ]
    },
    {
     "type": "action",
     "action": "click",
     "selector": {
      "label": "Cancel"
     },
     "expect": {
      "selector": {
       "role": "AXTextArea"
      },
      "condition": "absent"
     },
     "timeout": 8
    }
   ]
  }
 }
]
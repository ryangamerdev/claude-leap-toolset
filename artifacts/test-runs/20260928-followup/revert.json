[
 {
  "name": "session_open",
  "arguments": {
   "project": "/Users/ryan/src/leap-mcp/.leap/tmp/harness-project",
   "app": "Gameday"
  }
 },
 {
  "name": "@capture",
  "arguments": {
   "pattern": "\"session_id\":\"([A-F0-9-]+)\"",
   "var": "sid"
  }
 },
 {
  "name": "ui_perform",
  "arguments": {
   "session_id": "$sid",
   "steps": [
    {
     "type": "action",
     "action": "click",
     "selector": {
      "label": "Cancel",
      "role": "AXButton"
     },
     "expect": {
      "selector": {
       "label": "Play title"
      },
      "condition": "absent"
     },
     "timeout": 6
    }
   ]
  }
 }
]
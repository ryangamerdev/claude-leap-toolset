  {"name": "get_app_state", "arguments": {"app": "Simulator", "include_screenshot": false, "disable_diff": true}},
  {"name": "@capture", "arguments": {"pattern": "\\[(\\d+)\\] MenuBarItem \"Window\" actions", "var": "closedTitle"}},
